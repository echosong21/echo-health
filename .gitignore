# 密钥
.env
*.env
!example.env
# 运行产物
logs/
*.log
*.db
# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/
# 大数据（语料/索引，不进仓）
corpus/
data/
# 分词器缓存（jieba 默认写在当前工作目录，会污染工作区）
jieba.cache
# IDE / OS
.idea/
.vscode/
.DS_Store# pytest 运行时会创建的临时缓存目录（沙箱下可能无法删除，用忽略处理）
pytest-cache-files-*/
# 测试用的项目内临时目录（避开 %TEMP% 的 ACL 锁定问题，见 tests/conftest.py）
.pytest_tmp/

# 语料来源清单与下载记录（内部资料，不入仓）
_sources/

# 下载暂存区（原始数据，转换后不保留）
_staging/
